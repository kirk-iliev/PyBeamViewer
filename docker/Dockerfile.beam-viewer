FROM python:3.12-slim

# Install runtime Python dependencies (no Qt/X11 needed for headless)
RUN pip install --no-cache-dir \
    caproto \
    scipy \
    numpy \
    fastapi \
    uvicorn \
    pillow \
    fastmcp \
    websockets

# Copy application source
COPY mcp_servers/beam_viewer /app/beam_viewer

# Copy default configuration
COPY config/config.json /app/config.default/config.json

# Environment
ENV PYTHONPATH=/app
ENV MCP_TRANSPORT=http
ENV MCP_PORT=8007
ENV BEAMVIEWER_CONFIG=/app/config/config.json
ENV OSPREY_CONFIG=/app/config/config.yml

EXPOSE 8007

CMD ["python", "-m", "beam_viewer"]
